---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Fant ikke siden | ByggFlyt.no"
  description="Siden finnes ikke. Gå tilbake til ByggFlyt B2B-katalogen eller åpne våre 06:45 anleggskalkulatorer."
  canonicalPath="/404/"
>
  <section class="section-block">
    <div class="container">
      <div class="card">
        <span class="badge badge-partner-open">HTTP 404</span>
        <h1 class="section-title">Denne ruten finnes ikke på ByggFlyt.no</h1>
        <p class="card-text">
          Sjekk nettadressen eller gå direkte til oversikten over våre 50 lokale fagsoner og 06:45-kalkulatorer på Østlandet.
        </p>
        <div class="hero-actions">
          <a href="/" class="btn btn-primary">Til forsiden</a>
          <a href="/kalkulator/" class="btn btn-outline">Åpne 06:45 kalkulatorer</a>
          <a href="/bli-partner/" class="btn btn-outline">Se ledige partner-territorier</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
