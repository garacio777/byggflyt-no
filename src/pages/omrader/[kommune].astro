---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalculatorWidget from "../../components/CalculatorWidget.astro";
import LeadCaptureForm from "../../components/LeadCaptureForm.astro";
import { CATEGORIES } from "../../data/categories.js";
import { MUNICIPALITIES, type MunicipalityProfile } from "../../data/municipalities.js";

export function getStaticPaths() {
  return MUNICIPALITIES.map((municipality) => ({
    params: { kommune: municipality.slug },
    props: { municipality }
  }));
}

interface Props {
  municipality: MunicipalityProfile;
}

const { municipality } = Astro.props;
const isStrictZeroEmission = municipality.emissionPolicyLevel === "STRENG_UTSLIPPSFRI";
---

<BaseLayout
  title={`Maskinutleie, Rigg, Lift & Byggvarme i ${municipality.name} | ByggFlyt`}
  description={`B2B rigg- og maskinportal for ${municipality.name} (${municipality.keyHubs.join(", ")}). Lokale kalkulatorer tilpasset ${municipality.frostDepthCm} cm teledybde, grunnforhold og miljøkrav.`}
  canonicalPath={`/omrader/${municipality.slug}/`}
>
  <section class="hero-section">
    <div class="container">
      <div class="hero-split">
        <div>
          <nav class="breadcrumb-nav" aria-label="Brødsmulesti">
            <a href="/">Hjem</a>
            <span>/</span>
            <span>{municipality.name}</span>
          </nav>
          <div class="eyebrow-row">
            <span class="badge badge-amber">{municipality.county.toUpperCase()} • POSTNR. {municipality.postalRange}</span>
            <span class="badge badge-emerald">DIM. VINTERTEMP: {municipality.designWinterTempC} °C</span>
          </div>
          <h1 class="hero-title">Rigg, Maskinutleie og Byggedrift i {municipality.name}</h1>
          <p class="hero-lead">
            Dekker byggeplasser i {municipality.keyHubs.join(", ")}. Dimensjoner riktig utstyr etter lokale grunnforhold,
            utslippskrav og transportaksene {municipality.logisticsCorridors}.
          </p>

          <div class="kpi-white-grid">
            <div class="kpi-white-card">
              <span class="kpi-white-num">~{municipality.frostDepthCm} cm</span>
              <span class="kpi-white-label">Telefri dybde</span>
            </div>
            <div class="kpi-white-card">
              <span class="kpi-white-num">{municipality.designWinterTempC} °C</span>
              <span class="kpi-white-label">Dimensjonerende kulde</span>
            </div>
            <div class="kpi-white-card">
              <span class="kpi-white-num">5 fag</span>
              <span class="kpi-white-label">Lokale kalkulatorer</span>
            </div>
            <div class="kpi-white-card">
              <span class="kpi-white-num">100 % B2B</span>
              <span class="kpi-white-label">Brreg / EHF-sjekk</span>
            </div>
          </div>
        </div>

        <div class="hero-photo-frame">
          <img
            src="/images/hero-nordic-rigg.webp"
            alt={`Rigg, beltegraver og personløfter for byggeplasser i ${municipality.name}`}
            width="1280"
            height="720"
            fetchpriority="high"
            class="hero-photo-img"
          />
          <div class="telemetry-hud-bar">
            <span class="telemetry-pill">{municipality.shortName.toUpperCase()}</span>
            <span class="telemetry-pill">FLYTTING: {municipality.flatbedTransferNokRange}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h2 class="card-title">Lokale grunnforhold i {municipality.name}</h2>
          <p class="card-text">{municipality.groundConditionProfile}</p>
        </div>
        <div class="card">
          <h2 class="card-title">Klima- og utslippskrav ved anbud og byggeplass</h2>
          <p class="card-text">{municipality.emissionPolicySummary}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block section-subtle">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Velg fagområde i {municipality.name}</h2>
        <p class="section-desc">
          Gå rett til spesialisert kalkulator og bestillingsside for valgt fag i {municipality.shortName}.
        </p>
      </div>
      <div class="grid-3">
        {
          CATEGORIES.map((cat) => (
            <a href={`/utleie/${municipality.slug}/${cat.slug}/`} class="card-catalog">
              <div class="card-media-wrap">
                <img
                  src={cat.imageSrc}
                  alt={`${cat.shortTitle} i ${municipality.name}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  class="card-media-img"
                />
                <span class="card-badge-overlay">{cat.badgeCode}</span>
                <span class="card-rate-pill">Fra {cat.baseDailyRateNok.toLocaleString("nb-NO")} kr/døgn</span>
              </div>
              <div class="card-catalog-body">
                <h3 class="card-title">
                  {cat.shortTitle} i {municipality.shortName}
                </h3>
                <div class="spec-chip-row">
                  {cat.telemetrySpecs.map((spec) => (
                    <span class="spec-chip">{spec}</span>
                  ))}
                </div>
                <p class="card-text">{cat.heroTagline}</p>
                <div class="card-meta">
                  <span>{cat.typicalTicketRangeNok}</span>
                  <span>Beregn &amp; bestill →</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Feltkalkulator forhåndsinnstilt for {municipality.name}</h2>
      </div>
      <CalculatorWidget
        showAllTabs={true}
        defaultFrostDepthCm={municipality.frostDepthCm}
        defaultWinterTempC={municipality.designWinterTempC}
        defaultZeroEmission={isStrictZeroEmission}
      />
    </div>
  </section>

  <section class="section-block section-subtle">
    <div class="container">
      <LeadCaptureForm
        defaultMunicipality={municipality.slug}
        defaultPostalCode={municipality.samplePostalCode}
        headingText={`Send spesifisert B2B-forespørsel i ${municipality.name}`}
      />
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="partner-callout">
        <div>
          <span class="badge badge-partner-open">LEDIG PARTNER-TERRITORIUM I {municipality.shortName.toUpperCase()}</span>
          <h2 class="card-title">Driver dere utleiedepot eller anleggsdrift i {municipality.name}?</h2>
          <p class="card-text">
            Reserver eksklusiv tilgang til Brreg-verifiserte B2B-oppdrag i {municipality.name} uten budrunde mot konkurrenter.
          </p>
        </div>
        <a href={`/bli-partner/?kommune=${municipality.slug}#reservasjon`} class="btn btn-dark btn-sm">
          Reserver territorium →
        </a>
      </div>
    </div>
  </section>

  <script src="../../scripts/directory-client.ts"></script>
</BaseLayout>
