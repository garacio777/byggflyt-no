---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalculatorWidget from "../../components/CalculatorWidget.astro";
import LeadCaptureForm from "../../components/LeadCaptureForm.astro";
import { CATEGORIES } from "../../data/categories.js";
import { MUNICIPALITIES, type MunicipalityProfile } from "../../data/municipalities.js";

export function getStaticPaths() {
  return MUNICIPALITIES.map((municipality) => ({
    params: { kommune: municipality.slug },
    props: { municipality }
  }));
}

interface Props {
  municipality: MunicipalityProfile;
}

const { municipality } = Astro.props;
const isStrictZeroEmission = municipality.emissionPolicyLevel === "STRENG_UTSLIPPSFRI";
---

<BaseLayout
  title={`Maskinutleie, Rigg, Lift & Byggvarme i ${municipality.name} | ByggFlyt`}
  description={`B2B rigg- og maskinportal for ${municipality.name} (${municipality.keyHubs.join(", ")}). Lokale kalkulatorer tilpasset ${municipality.frostDepthCm} cm teledybde, grunnforhold og miljøkrav.`}
  canonicalPath={`/omrader/${municipality.slug}/`}
>
  <section class="hero-section">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Brødsmulesti">
        <a href="/">Hjem</a>
        <span>/</span>
        <span>{municipality.name}</span>
      </nav>
      <div class="eyebrow-row">
        <span class="badge badge-amber">{municipality.county.toUpperCase()} • POSTNR. {municipality.postalRange}</span>
        <span class="badge badge-emerald">DIM. VINTERTEMP: {municipality.designWinterTempC} °C</span>
      </div>
      <h1 class="hero-title">Rigg, Maskinutleie og Byggedrift i {municipality.name}</h1>
      <p class="hero-lead">
        Dekker byggeplasser i {municipality.keyHubs.join(", ")}. Dimensjoner riktig utstyr etter lokale grunnforhold,
        utslippskrav og transportaksene {municipality.logisticsCorridors}.
      </p>

      <div class="hero-stats-grid">
        <div class="stat-card-dark">
          <span class="stat-label">Telefri dybde (referanse)</span>
          <span class="stat-value">~{municipality.frostDepthCm} cm</span>
        </div>
        <div class="stat-card-dark">
          <span class="stat-label">Dimensjonerende kulde</span>
          <span class="stat-value">{municipality.designWinterTempC} °C</span>
        </div>
        <div class="stat-card-dark">
          <span class="stat-label">Typisk maskinflytting</span>
          <span class="stat-value">{municipality.flatbedTransferNokRange}</span>
        </div>
        <div class="stat-card-dark">
          <span class="stat-label">Hovedkorridorer</span>
          <span class="stat-value">{municipality.logisticsCorridors.split(",")[0]}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h2 class="card-title">Lokale grunnforhold i {municipality.name}</h2>
          <p class="card-text">{municipality.groundConditionProfile}</p>
        </div>
        <div class="card">
          <h2 class="card-title">Klima- og utslippskrav ved anbud og byggeplass</h2>
          <p class="card-text">{municipality.emissionPolicySummary}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block section-subtle">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Velg fagområde i {municipality.name}</h2>
        <p class="section-desc">
          Gå rett til spesialisert kalkulator og bestillingsside for valgt fag i {municipality.shortName}.
        </p>
      </div>
      <div class="grid-3">
        {
          CATEGORIES.map((cat) => (
            <a href={`/utleie/${municipality.slug}/${cat.slug}/`} class="card card-interactive">
              <span class="badge badge-light">{cat.badgeCode}</span>
              <h3 class="card-title">
                {cat.shortTitle} i {municipality.shortName}
              </h3>
              <p class="card-text">{cat.heroTagline}</p>
              <div class="card-meta">
                <span>{cat.typicalTicketRangeNok}</span>
                <span>Beregn &amp; bestill →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Feltkalkulator forhåndsinnstilt for {municipality.name}</h2>
      </div>
      <CalculatorWidget
        showAllTabs={true}
        defaultFrostDepthCm={municipality.frostDepthCm}
        defaultWinterTempC={municipality.designWinterTempC}
        defaultZeroEmission={isStrictZeroEmission}
      />
    </div>
  </section>

  <section class="section-block section-subtle">
    <div class="container">
      <LeadCaptureForm
        defaultMunicipality={municipality.slug}
        defaultPostalCode={municipality.samplePostalCode}
        headingText={`Send spesifisert B2B-forespørsel i ${municipality.name}`}
      />
    </div>
  </section>

  <script src="../../scripts/directory-client.ts"></script>
</BaseLayout>
