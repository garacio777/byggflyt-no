# ByggFlyt.no — Outbound B2B Lead & Partner Notification Channels
# Configure one or more channels in Vercel (`npx vercel env add <NAME> production`)
# or Cloudflare Pages Secrets (`npx wrangler pages secret put <NAME>`).

# 1. Generic HTTPS JSON Webhook (Make.com, Zapier, n8n, HubSpot, Pipedrive, or Partner Depot API)
PARTNER_WEBHOOK_URL=

# 2. Slack Incoming Webhook URL (or Discord Webhook URL appended with `/slack`)
# Sends formatted Block Kit cards with Org.nr, SKU, NOK estimate, postal code, and SLA.
SLACK_WEBHOOK_URL=

# 3. Direct Email Dispatch via Resend HTTPS API (https://resend.com)
# Both RESEND_API_KEY and LEAD_NOTIFY_EMAIL must be set to enable email delivery.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=ByggFlyt Dispatch <onboarding@resend.dev>
