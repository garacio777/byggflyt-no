# ByggFlyt.no — Outbound B2B Lead & Partner Territory Reservation Channels
# Configure in Vercel Production (`npx vercel env add <NAME> production`) or `.env.local` for local testing.

# ── 1. RECOMMENDED: Direct Mailbox ESMTP (Proton Mail Plus/Unlimited or Domeneshop — Zero Database / Zero 3rd-Party API) ──
# All-or-nothing guard: set SMTP_USER, SMTP_PASSWORD, and BOOKING_NOTIFY_EMAIL together, or leave all three empty.
# Verify locally with: `npm run email:test` (or `npm run email:test -- --auth-only`).
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BOOKING_NOTIFY_EMAIL=
# Optional custom sender display name (address domain must match SMTP_USER):
EMAIL_FROM=

# ── 2. Optional: Generic HTTPS JSON Webhook (Make.com, Zapier, n8n, HubSpot, Pipedrive, or Partner Depot API) ──
PARTNER_WEBHOOK_URL=

# ── 3. Optional: Slack Incoming Webhook URL (or Discord Webhook URL appended with `/slack`) ──
SLACK_WEBHOOK_URL=

# ── 4. Optional Legacy Fallback: Resend HTTPS API (used only when Direct Mailbox SMTP is unset) ──
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# ── Optional Local-Only CMS / Admin Prototype (`npm run platform` on 127.0.0.1) ──
# External partners register directly on the public `/bli-partner/` page — localhost 4323 is NOT needed in production.
ADMIN_USERNAME=admin
ADMIN_ACCESS_CODE=
ADMIN_PORT=4322
ADMIN_HOST=127.0.0.1
PARTNER_PORT=4323
PARTNER_HOST=127.0.0.1
PLATFORM_SECURE_COOKIES=0
PLATFORM_DB_PATH=data/platform.db
PLATFORM_INGEST_TOKEN=
